# Generated by Scripts/build_configs.py. Do not edit manually.
name: Proxy Modular Kit
desc: 模块化策略组和高优先级规则；策略组直接引用配置中的全部节点
proxy-groups:
- name: 📈 美股交易
  type: select
  include-all: true
- name: 🤖 AI
  type: select
  include-all: true
  proxies:
  - DIRECT
- name: 💻 GitHub
  type: select
  include-all: true
  proxies:
  - DIRECT
- name: 🌍 Google
  type: select
  include-all: true
  proxies:
  - DIRECT
- name: 📺 媒体
  type: select
  include-all: true
  proxies:
  - DIRECT
